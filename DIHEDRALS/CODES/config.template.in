#### model parameters

# encoder
ENCODER_TYPE = GAT
# GCN, SAGE, GAT
HIDDEN_ENCODER_CHANNELS = 256
OUT_ENCODER_CHANNELS = 64
NUM_ENC_LAYERS: 10
ATTENTION_ENCODER = False
HEADS_ENCODER = 3
LATENT_DIM: 16
#TANH_ENCODER =  True
NORMALIZE_ENCODER = True

# decoder
HIDDEN_DECODER_CHANNELS = 256
NUM_DEC_LAYERS: 10
#ATTENTION_DECODER = True
#TANH_DECODER = True
#NORMALIZE_DECODER =  True

#### training parameters
EPOCHS = 500
BATCHSIZE =  64
LEARNING_RATE =  1e-3
WARMUP_EPOCHS = 0
WEIGHT_DECAY = 0


#### Scheduler parameters
USE_SCHEDULER =  True
SCHEDULER_PATIENCE =  15
SCHEDULER_FACTOR = 0.8
SCHEDULER_TYPE = ReduceLROnPlateau
SCHEDULER_THRESHOLD =  0.0001

# Beta annealing parameters
BETA = None
CYCLIC_BETA = False
CYCLE_LENGTH = 100
wait_epochs =  30
annealing_epochs = 3000
beta_min = 1e-4
beta_max = 1e-2

advanced_kl_loss = True
tc_weight=30.0
mi_weight = 0
dkl_weight=1.0


# Other parameters
DISABLE_TQDM = True
SEED =  42
NAME_SIMULATION = 12-gat-double-skip-bigdec-continues
NAME_FOLDER = adv_kl_loss
CONTINUE_FROM = /home/clod/Desktop/THESIS_2/DIHEDRALS/RUNS/adv_kl_loss/12-gat-double-skip-bigdec/model_epoch_200.pth
