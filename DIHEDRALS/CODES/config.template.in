#############################################################################################################


#### model parameters

# encoder
ENCODER_TYPE = SAGE
HIDDEN_ENCODER_CHANNELS = 128
OUT_ENCODER_CHANNELS = 64
NUM_ENC_LAYERS: 6
#ATTENTION_ENCODER = True
LATENT_DIM: 4
#TANH_ENCODER =  True
#NORMALIZE_ENCODER = True

# decoder
HIDDEN_DECODER_CHANNELS = 128
NUM_DEC_LAYERS: 6
#ATTENTION_DECODER = True
#TANH_DECODER = True
#NORMALIZE_DECODER =  True

#### training parameters
EPOCHS = 30
BATCHSIZE =  64
LEARNING_RATE =  1E-5
WEIGHT_DECAY = 0


#### Scheduler parameters
USE_SCHEDULER =  False
SCHEDULER_PATIENCE =  10
SCHEDULER_FACTOR = 0.5
SCHEDULER_TYPE = ReduceLROnPlateau
SCHEDULER_THRESHOLD =  0.0001

# Beta annealing parameters
BETA = None
wait_epochs =  10
annealing_epochs = 100
beta_min = 0.00001
beta_max = 0.001

# Other parameters
DISABLE_TQDM = False
SEED =  42
NAME_SIMULATION =  None
NAME_FOLDER = None
CONTINUE_FROM = None
STARTING_EPOCH = 20
#TEST_MODEL = True
MIN_KL = 0.01

