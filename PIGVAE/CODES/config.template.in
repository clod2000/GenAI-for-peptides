##############################
# Advanced Model Architecture
##############################

# Defines the overall VAE architecture. Can be 'original' or 'hybrid_displacement'.
# 'original': The initial implementation.
# 'hybrid_displacement': The new model that uses an explicit encoder and a displacement decoder.

MODEL_ARCHITECTURE =  original
#original_egnn
# hybrid_displacement
# original

# If using 'hybrid_displacement', this is the dimension for the flattened coordinate projection.
ENCODER_POS_PROJECTION_DIM: 8 
# ( Not used in official_egnn)

## Training type ( Not implemented yet in official_egnn)
TRAINING_MODE = denoising
# 'denoising' or 'generative', denoising adds nois to the reference position
NOISE_LEVEL = 0.1
# in nm

##########################################
# Common parameters for both architectures
##########################################



#### model parameters

## encoder
ENCODER_TYPE = standard
#denoise or standard, here denoise is for the original, adds noise to encoder input pos
NOISE_LV = 0.2
NOISE_ANNEALING = True
#standard
HIDDEN_ENCODER_CHANNELS = 256
OUT_ENCODER_CHANNELS = 128
NUM_ENC_LAYERS: 10
ATTENTION_ENCODER = True
LATENT_DIM: 128
TANH_ENCODER =  True
NORMALIZE_ENCODER = True

# decoder
MLP_DECODER_POS_SIZE = [128,128,64]
HIDDEN_DECODER_CHANNELS = 128
#128
NUM_DEC_LAYERS: 5
ATTENTION_DECODER = False
TANH_DECODER = True
NORMALIZE_DECODER =  True

#### dataset parameters
INCLUDE_ATOM_TYPE = True
SCALE_FEATURES = True
SCALE_POSITIONS = False
INITIAL_ALIGNMENT = False
return_pos_angstrom = False

#### training parameters
EPOCHS = 50
BATCHSIZE =  64
LEARNING_RATE = 1E-5
WARMUP_EPOCHS = 20
WEIGHT_DECAY = 0


advanced_recon_loss = True
advanced_kl_loss = True

tc_weight=10.0
mi_weight = 0
dkl_weight=1.0


#### Scheduler parameters
USE_SCHEDULER =  True
SCHEDULER_PATIENCE =  5
SCHEDULER_FACTOR = 0.5
SCHEDULER_TYPE = ReduceLROnPlateau
SCHEDULER_THRESHOLD =  0.0001

# Beta annealing parameters
BETA = 1e-6
CYCLIC_BETA = False
CYCLE_LENGTH = 10
wait_epochs =  20
annealing_epochs = 100
beta_min = 1e-4
beta_max = 1e-3
MIN_KL = 1E-4
tc_weight = 10

# force field parameters
USE_FORCE_FIELD = True
PDB_FOR_ENERGY = ../DATA/raw/protein_only.pdb
LAMBDA_ENERGY = 0.
#None
#1e-10
wait_lambda_epochs = 10
lambda_annealing_epochs = 400
lambda_min = 1e-5
lambda_max = 1e-5

USE_LOG_FF = False
# if True, the force field loss is calculated using log scaling, otherwise it is calculated using the raw values
USE_BOND_FF = True
# if True, the bonded energy is included in the force field loss
USE_ANGLE_FF = True
# if True, the angle energy is included in the force field loss
USE_LJ_FF = False
# if True, the Lennard-Jones energy is included in the force field loss



# Other parameters
DISABLE_TQDM = False
SEED =  42
NAME_SIMULATION = new_pigvae
NAME_FOLDER = updated_v2
CONTINUE_FROM = None
#/home/claudio.colturi/THESIS_2/PIGVAE/RUNS/original/Phase_0.1/DAE_warmup
# /home/claudio.colturi/THESIS_2/PIGVAE/RUNS/original/Phase_2/AE_angle_bonds_lj_210/model_epoch_270.pth

STARTING_EPOCH =0
ALIGN_RECONS_LOSS = True
TEST_MODEL = True




